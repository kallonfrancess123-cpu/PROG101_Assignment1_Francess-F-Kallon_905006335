digraph CleanSalone {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.28", ranksep="0.25", splines=polyline,
         fontname="Arial", fontsize=12, labelloc="t", label="CleanSalone SL - Main Waste Report Workflow"];
  node [fontname="Arial", fontsize=10, color="#23475B", fontcolor="#183746", penwidth=1.3,
        style="filled,rounded", fillcolor="#EAF4F7", margin="0.15,0.08"];
  edge [fontname="Arial", fontsize=9, color="#496B7A", fontcolor="#304F5C", arrowsize=0.7, penwidth=1.1];
  start [label="START", shape=oval, fillcolor="#D7EFE8"];
  input [label="Capture report details\n(area, location, category, volume, risk flags)", shape=box];
  valid [label="Required fields\nvalid?", shape=diamond, style=filled, fillcolor="#FFF2CC", margin="0.10,0.05"];
  fix [label="Show missing fields;\ncorrect or cancel", shape=box, fillcolor="#FCE8E6"];
  duplicate [label="Matching unresolved report\nwithin previous 72 hours?", shape=diamond, style=filled, fillcolor="#FFF2CC", margin="0.10,0.05"];
  link [label="Link new details; reuse ID and reassess priority", shape=box, fillcolor="#E8EAF6"];
  newcase [label="Generate new case ID", shape=box];
  hazard [label="Medical or hazardous\nwaste?", shape=diamond, style=filled, fillcolor="#FFF2CC", margin="0.10,0.05"];
  specialist [label="SPECIALIST ESCALATION;\nroute for specialist review", shape=box, fillcolor="#FCE8E6"];
  score [label="Calculate risk score and classify\nHIGH / MEDIUM / ROUTINE", shape=box];
  route [label="Look up approved local route;\nmanual routing if no match", shape=box];
  save [label="Save or update report and status", shape=box, fillcolor="#E8EAF6"];
  receipt [label="Display case ID, priority, status\nand next steps", shape=box, fillcolor="#D7EFE8"];
  end [label="END", shape=oval, fillcolor="#D7EFE8"];

  start -> input -> valid;
  valid -> duplicate [label="YES"];
  valid -> fix [label="NO"];
  fix -> input [label="RETRY", constraint=false];
  duplicate -> link [label="YES"];
  duplicate -> newcase [label="NO"];
  link -> save;
  newcase -> hazard;
  hazard -> specialist [label="YES"];
  hazard -> score [label="NO"];
  specialist -> save;
  score -> route -> save;
  save -> receipt -> end;
  {rank=same; link; newcase}
  {rank=same; specialist; score}
}